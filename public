<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Delta — Entrepreneurship, without borders</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --black-950:#050607;
    --black-900:#0A0C0E;
    --black-850:#0D0F12;
    --black-800:#14171B;
    --black-750:#1A1E23;
    --silver-100:#F1F2F4;
    --silver-300:#C7CBD1;
    --silver-500:#8B909A;
    --silver-700:#565B63;
    --line:rgba(199,203,209,0.22);
    --line-bright:rgba(241,242,244,0.55);
    --display:'Space Grotesk', ui-sans-serif, sans-serif;
    --body:'Inter', ui-sans-serif, sans-serif;
    --mono:'IBM Plex Mono', ui-monospace, monospace;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }

  html{ scroll-behavior:smooth; }

  body{
    background:var(--black-950);
    color:var(--silver-300);
    font-family:var(--body);
    line-height:1.5;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }

  a{ color:inherit; text-decoration:none; }

  .wrap{
    max-width:1180px;
    margin:0 auto;
    padding:0 32px;
  }

  ::selection{ background:var(--silver-100); color:var(--black-950); }

  :focus-visible{
    outline:1px solid var(--silver-100);
    outline-offset:3px;
  }

  /* ---------- background texture: faint grid ---------- */
  .bg-grid{
    position:fixed;
    inset:0;
    z-index:0;
    background-image:
      linear-gradient(to right, rgba(199,203,209,0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(199,203,209,0.045) 1px, transparent 1px);
    background-size:64px 64px;
    mask-image:radial-gradient(ellipse 90% 70% at 50% 0%, black 40%, transparent 90%);
    pointer-events:none;
  }

  /* ---------- header ---------- */
  header{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(5,6,7,0.82);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }

  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:22px 32px;
  }

  .logo{
    font-family:var(--display);
    font-size:20px;
    font-weight:700;
    letter-spacing:0.02em;
    color:var(--silver-100);
    display:flex;
    align-items:center;
    gap:9px;
  }
  .logo .mark{
    width:16px; height:16px;
    border:1px solid var(--silver-100);
    transform:rotate(45deg);
    flex-shrink:0;
  }

  .nav-links{
    display:flex;
    align-items:center;
    gap:36px;
    font-size:14px;
    color:var(--silver-500);
  }
  .nav-links a{ transition:color .2s ease; }
  .nav-links a:hover{ color:var(--silver-100); }

  .nav-cta{
    display:flex; gap:12px; align-items:center;
  }

  .btn{
    font-family:var(--body);
    font-size:14px;
    font-weight:500;
    padding:10px 20px;
    border:1px solid var(--line-bright);
    background:transparent;
    color:var(--silver-100);
    cursor:pointer;
    transition:background .2s ease, color .2s ease, border-color .2s ease;
    white-space:nowrap;
    display:inline-block;
  }
  .btn:hover{ background:var(--silver-100); color:var(--black-950); }
  .btn.ghost{ border-color:var(--line); color:var(--silver-300); }
  .btn.ghost:hover{ border-color:var(--line-bright); background:transparent; color:var(--silver-100); }
  .btn.small{ padding:7px 14px; font-size:12.5px; }

  .nav-mobile-toggle{ display:none; }

  /* ---------- vision strip (in header) ---------- */
  .vision-strip{
    border-top:1px solid var(--line);
    padding:10px 32px;
    text-align:center;
    font-family:var(--mono);
    font-size:11.5px;
    letter-spacing:0.10em;
    text-transform:uppercase;
    color:var(--silver-500);
  }
  .vision-strip strong{
    color:var(--silver-100);
    font-weight:500;
  }

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    padding:110px 32px 60px;
    text-align:center;
    overflow:hidden;
  }

  .eyebrow{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--silver-500);
    display:inline-flex;
    align-items:center;
    gap:10px;
    margin-bottom:26px;
  }
  .eyebrow::before, .eyebrow::after{
    content:'';
    width:26px; height:1px;
    background:var(--line-bright);
  }

  h1{
    font-family:var(--display);
    font-weight:600;
    font-size:clamp(36px, 6vw, 68px);
    line-height:1.06;
    letter-spacing:-0.02em;
    color:var(--silver-100);
    max-width:920px;
    margin:0 auto 26px;
  }
  h1 em{
    font-style:normal;
    color:var(--silver-100);
    border-bottom:1px solid var(--line-bright);
  }

  .hero-sub{
    max-width:560px;
    margin:0 auto 44px;
    font-size:16.5px;
    color:var(--silver-500);
  }

  .hero-ctas{
    display:flex;
    gap:14px;
    justify-content:center;
    flex-wrap:wrap;
    margin-bottom:90px;
    position:relative;
    z-index:5;
  }

  /* ---------- globe-grid signature ---------- */
  .globe-stage{
    position:relative;
    height:560px;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .globe-svg{
    position:absolute;
    top:50%; left:50%;
    transform:translate(-50%,-50%);
    width:min(640px, 90vw);
    height:min(640px, 90vw);
    opacity:0.9;
    animation:spin 90s linear infinite;
  }
  .globe-svg ellipse, .globe-svg circle{
    fill:none;
    stroke:var(--silver-700);
    stroke-width:1;
  }
  .globe-svg .bright{ stroke:var(--silver-500); }
  .globe-svg .core{ stroke:var(--line-bright); }

  @keyframes spin{
    from{ transform:translate(-50%,-50%) rotate(0deg); }
    to{ transform:translate(-50%,-50%) rotate(360deg); }
  }

  /* ---------- floating role cards ---------- */
  .orbit{
    position:relative;
    width:100%;
    max-width:960px;
    height:100%;
    z-index:5;
  }

  .role-card{
    position:absolute;
    width:230px;
    text-align:left;
    background:rgba(13,15,18,0.72);
    backdrop-filter:blur(6px);
    border:1px solid var(--line-bright);
    padding:22px;
    animation:float 7s ease-in-out infinite;
    transition:border-color .25s ease, transform .25s ease, background .25s ease;
  }
  .role-card:hover{
    border-color:var(--silver-100);
    background:rgba(20,23,27,0.9);
    transform:translateY(-6px) !important;
  }

  .role-card.founder{ top:6%;  left:2%;  animation-delay:0s; }
  .role-card.investor{ top:2%; right:0%; animation-delay:1.4s; }
  .role-card.consultant{ bottom:2%; left:50%; margin-left:-115px; animation-delay:2.8s; }

  @keyframes float{
    0%, 100%{ transform:translateY(0px); }
    50%{ transform:translateY(-14px); }
  }

  .role-tag{
    font-family:var(--mono);
    font-size:10.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--silver-500);
    display:flex;
    align-items:center;
    gap:8px;
    margin-bottom:14px;
  }
  .role-tag .dot{
    width:6px; height:6px;
    border:1px solid var(--silver-100);
    border-radius:50%;
  }

  .role-card h3{
    font-family:var(--display);
    font-size:19px;
    font-weight:600;
    color:var(--silver-100);
    margin-bottom:10px;
  }

  .role-card p{
    font-size:13px;
    color:var(--silver-500);
    margin-bottom:16px;
  }

  .role-enter{
    font-family:var(--mono);
    font-size:11.5px;
    letter-spacing:0.06em;
    color:var(--silver-300);
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .role-card:hover .role-enter{ color:var(--silver-100); }
  .role-enter .arrow{ transition:transform .2s ease; }
  .role-card:hover .role-enter .arrow{ transform:translateX(3px); }

  @media (prefers-reduced-motion: reduce){
    .globe-svg{ animation:none; }
    .role-card{ animation:none; }
  }

  /* ---------- section shell ---------- */
  section{ position:relative; z-index:1; }
  .section-pad{ padding:100px 32px; }
  .divider{ border-top:1px solid var(--line); }

  .section-head{
    max-width:560px;
    margin:0 auto 64px;
    text-align:center;
  }
  .section-head .eyebrow{ margin-bottom:18px; }
  .section-head h2{
    font-family:var(--display);
    font-size:clamp(28px, 4vw, 40px);
    font-weight:600;
    color:var(--silver-100);
    letter-spacing:-0.01em;
    margin-bottom:14px;
  }
  .section-head p{ color:var(--silver-500); font-size:15.5px; }

  /* ---------- how it works ---------- */
  .steps{
    max-width:1000px;
    margin:0 auto;
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:0;
    border:1px solid var(--line);
  }
  .step{
    padding:36px 30px;
    border-right:1px solid var(--line);
    position:relative;
  }
  .step:last-child{ border-right:none; }
  .step-num{
    font-family:var(--mono);
    font-size:12px;
    color:var(--silver-700);
    margin-bottom:22px;
    letter-spacing:0.06em;
  }
  .step h4{
    font-family:var(--display);
    font-size:17px;
    font-weight:600;
    color:var(--silver-100);
    margin-bottom:10px;
  }
  .step p{ font-size:13.5px; color:var(--silver-500); }

  /* ---------- role paths (detailed) ---------- */
  .paths{
    max-width:1000px;
    margin:0 auto;
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:22px;
  }
  .path-card{
    border:1px solid var(--line);
    padding:32px 26px;
    transition:border-color .2s ease, transform .2s ease;
  }
  .path-card:hover{ border-color:var(--line-bright); transform:translateY(-4px); }
  .path-card .role-tag{ margin-bottom:20px; }
  .path-card h3{
    font-family:var(--display);
    font-size:21px;
    font-weight:600;
    color:var(--silver-100);
    margin-bottom:14px;
  }
  .path-list{ list-style:none; margin:0 0 22px; }
  .path-list li{
    font-size:13.5px;
    color:var(--silver-500);
    padding:9px 0;
    border-top:1px solid var(--line);
    display:flex;
    gap:10px;
  }
  .path-list li:first-child{ border-top:none; }
  .path-list li::before{
    content:'—';
    color:var(--silver-700);
    flex-shrink:0;
  }

  /* ---------- trust strip ---------- */
  .trust{
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    padding:70px 32px;
  }
  .trust-inner{
    max-width:940px;
    margin:0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:50px;
    flex-wrap:wrap;
  }
  .trust-text{ max-width:440px; }
  .trust-text .eyebrow{ margin-bottom:16px; }
  .trust-text h3{
    font-family:var(--display);
    font-size:26px;
    font-weight:600;
    color:var(--silver-100);
    margin-bottom:12px;
    letter-spacing:-0.01em;
  }
  .trust-text p{ font-size:14.5px; color:var(--silver-500); }

  .trust-diagram{
    display:flex;
    align-items:center;
    gap:0;
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--silver-500);
  }
  .trust-node{
    width:78px; height:78px;
    border:1px solid var(--line-bright);
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:8px;
    background:var(--black-850);
  }
  .trust-node.filled{ border-color:var(--silver-100); color:var(--silver-100); }
  .trust-line{ width:34px; height:1px; background:var(--line-bright); }

  /* ---------- CTA band ---------- */
  .cta-band{
    text-align:center;
    padding:110px 32px;
  }
  .cta-band h2{
    font-family:var(--display);
    font-size:clamp(30px, 5vw, 50px);
    font-weight:600;
    color:var(--silver-100);
    letter-spacing:-0.015em;
    max-width:640px;
    margin:0 auto 30px;
  }
  .cta-band-buttons{
    display:flex;
    gap:14px;
    justify-content:center;
    flex-wrap:wrap;
  }

  /* ---------- footer ---------- */
  footer{
    border-top:1px solid var(--line);
    padding:50px 32px 34px;
  }
  .footer-inner{
    max-width:1180px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    flex-wrap:wrap;
    gap:36px;
  }
  .footer-brand .logo{ margin-bottom:14px; }
  .footer-brand p{ font-size:13px; color:var(--silver-700); max-width:280px; }
  .footer-cols{ display:flex; gap:64px; flex-wrap:wrap; }
  .footer-col h5{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--silver-700);
    margin-bottom:16px;
  }
  .footer-col a{
    display:block;
    font-size:13.5px;
    color:var(--silver-500);
    margin-bottom:11px;
    transition:color .2s ease;
  }
  .footer-col a:hover{ color:var(--silver-100); }
  .footer-bottom{
    max-width:1180px;
    margin:50px auto 0;
    padding-top:22px;
    border-top:1px solid var(--line);
    font-family:var(--mono);
    font-size:11px;
    color:var(--silver-700);
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:10px;
  }

  /* ---------- modal ---------- */
  .modal-overlay{
    position:fixed; inset:0; z-index:200;
    background:rgba(5,6,7,0.85);
    backdrop-filter:blur(4px);
    display:flex; align-items:center; justify-content:center;
    padding:24px;
  }
  .modal-box{
    background:var(--black-850);
    border:1px solid var(--line-bright);
    width:100%; max-width:440px;
    max-height:88vh;
    overflow-y:auto;
    padding:34px;
    position:relative;
  }
  .modal-close{
    position:absolute; top:18px; right:18px;
    background:none; border:1px solid var(--line);
    width:28px; height:28px;
    color:var(--silver-300);
    cursor:pointer;
    font-family:var(--body); font-size:15px; line-height:1;
  }
  .modal-close:hover{ border-color:var(--line-bright); color:var(--silver-100); }
  .modal-eyebrow{
    font-family:var(--mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--silver-500); margin-bottom:10px;
  }
  .modal-box h2{
    font-family:var(--display); font-size:24px; font-weight:600;
    color:var(--silver-100); margin-bottom:22px; letter-spacing:-0.01em;
  }
  .modal-foot{
    margin-top:20px; font-size:13px; color:var(--silver-500); text-align:center;
  }
  .modal-foot button{
    background:none; border:none; color:var(--silver-100);
    text-decoration:underline; cursor:pointer; font-size:13px; font-family:var(--body);
  }

  /* ---------- forms ---------- */
  .form-group{ margin-bottom:16px; }
  .form-group label{
    display:block; font-family:var(--mono); font-size:11px; letter-spacing:0.08em;
    text-transform:uppercase; color:var(--silver-500); margin-bottom:8px;
  }
  .form-row{ display:flex; gap:12px; }
  .form-row .form-group{ flex:1; }
  input[type="text"], input[type="email"], input[type="password"], input[type="tel"],
  input[type="number"], input[type="file"], select, textarea{
    width:100%;
    background:var(--black-900);
    border:1px solid var(--line);
    color:var(--silver-100);
    font-family:var(--body);
    font-size:14px;
    padding:11px 13px;
  }
  textarea{ resize:vertical; min-height:80px; }
  input:focus, select:focus, textarea:focus{ border-color:var(--line-bright); outline:none; }
  input::placeholder, textarea::placeholder{ color:var(--silver-700); }
  select{ appearance:none; cursor:pointer; }
  input[type="checkbox"]{ width:auto; accent-color:var(--silver-100); }
  .checkbox-row{ display:flex; align-items:center; gap:9px; font-size:13.5px; color:var(--silver-500); }
  .form-hint{ font-size:12px; color:var(--silver-700); margin-top:6px; }
  .form-error{
    border:1px solid var(--line-bright); color:var(--silver-100);
    padding:10px 12px; font-size:13px; margin-bottom:16px;
  }
  .form-submit{ width:100%; margin-top:6px; padding:13px; }
  .role-pick{ display:grid; grid-template-columns:1fr; gap:10px; }
  .role-pick button{
    text-align:left; padding:16px 18px; background:var(--black-900);
    border:1px solid var(--line); color:var(--silver-100); cursor:pointer;
    font-family:var(--body); transition:border-color .2s ease;
  }
  .role-pick button:hover{ border-color:var(--line-bright); }
  .role-pick button strong{ display:block; font-family:var(--display); font-size:16px; margin-bottom:4px; }
  .role-pick button span{ font-size:12.5px; color:var(--silver-500); }

  /* ---------- app / dashboard view ---------- */
  .app-view{ min-height:70vh; padding:40px 32px 90px; }
  .app-bar{
    max-width:1180px; margin:0 auto 40px; display:flex; align-items:center;
    justify-content:space-between; flex-wrap:wrap; gap:14px;
    padding-bottom:20px; border-bottom:1px solid var(--line);
  }
  .app-bar-left{ display:flex; align-items:center; gap:14px; }
  .role-badge{
    font-family:var(--mono); font-size:10.5px; letter-spacing:0.1em; text-transform:uppercase;
    color:var(--silver-100); border:1px solid var(--line-bright); padding:5px 10px;
  }
  .tabs{ display:flex; gap:8px; flex-wrap:wrap; max-width:1180px; margin:0 auto 32px; }
  .tab-btn{
    font-family:var(--mono); font-size:11.5px; letter-spacing:0.06em; text-transform:uppercase;
    padding:9px 16px; background:transparent; border:1px solid var(--line); color:var(--silver-500);
    cursor:pointer; transition:all .2s ease;
  }
  .tab-btn.active, .tab-btn:hover{ border-color:var(--line-bright); color:var(--silver-100); }
  .app-panel{ max-width:1180px; margin:0 auto; }
  .app-grid{ display:grid; grid-template-columns:1fr 1.4fr; gap:28px; align-items:start; }
  .panel-card{ border:1px solid var(--line); padding:26px; background:var(--black-850); }
  .panel-card h3{ font-family:var(--display); font-size:17px; color:var(--silver-100); margin-bottom:18px; font-weight:600; }
  .result-list{ display:flex; flex-direction:column; gap:14px; }
  .result-item{ border:1px solid var(--line); padding:18px 20px; transition:border-color .2s ease; }
  .result-item:hover{ border-color:var(--line-bright); }
  .result-item h4{ font-family:var(--display); font-size:16px; color:var(--silver-100); margin-bottom:6px; font-weight:600; }
  .result-meta{ font-family:var(--mono); font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase; color:var(--silver-500); margin-bottom:10px; }
  .result-desc{ font-size:13.5px; color:var(--silver-500); margin-bottom:14px; }
  .result-actions{ display:flex; gap:10px; }
  .empty-state{ border:1px dashed var(--line); padding:34px 20px; text-align:center; color:var(--silver-700); font-size:13.5px; }
  .toast{
    position:fixed; bottom:26px; left:50%; transform:translateX(-50%);
    background:var(--black-800); border:1px solid var(--line-bright); color:var(--silver-100);
    padding:12px 20px; font-size:13.5px; z-index:300;
  }
  .filter-row{ display:flex; gap:10px; flex-wrap:wrap; margin-bottom:22px; }
  .filter-row select, .filter-row input{ width:auto; min-width:150px; }
  .step-progress{
    font-family:var(--mono); font-size:11px; letter-spacing:0.08em; color:var(--silver-700);
    text-transform:uppercase; margin-bottom:20px;
  }
  .step-progress strong{ color:var(--silver-100); }

  @media (max-width:760px){
    .app-grid{ grid-template-columns:1fr; }
  }

  /* ---------- responsive ---------- */
  @media (max-width:860px){
    .nav-links{ display:none; }
    .globe-stage{ height:auto; padding:40px 0 20px; }
    .orbit{ position:static; display:flex; flex-direction:column; gap:16px; align-items:center; }
    .role-card{ position:static; width:100%; max-width:340px; margin:0 !important; animation:none; }
    .globe-svg{ position:relative; top:auto; left:auto; transform:none; margin-bottom:30px; }
    .steps{ grid-template-columns:1fr; }
    .step{ border-right:none; border-bottom:1px solid var(--line); }
    .step:last-child{ border-bottom:none; }
    .paths{ grid-template-columns:1fr; }
    .trust-inner{ justify-content:center; text-align:center; }
